{
  "name": "amqp-oop",
  "version": "0.0.0",
  "description": "WIP package",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.mts --coverage",
    "build": "rimraf dist && tsc --project tsconfig.json --removeComments &&  tsc --project tsconfig.json  --declaration --emitDeclarationOnly"
  },
  "repository": {
    "type": "git",
    "url": "amqp-oop"
  },
  "exports": {
    ".": "./dist/index.js",
    "./jest": "./dist/extensions/jest/index.js",
    "./vitest": "./dist/extensions/vitest/index.js",
    "./zod": "./dist/extensions/zod/index.js"
  },
  "keywords": [
    "amqp",
    "rabbitmq",
    "messaging"
  ],
  "author": "Patrik Valkovic",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^1.0.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@patrikvalkovic/eslint-config": "^1.0.9",
    "@types/amqplib": "^0.10.8",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^9.39.4",
    "jest": "^30.3.0",
    "@types/jest": "^30.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3",
    "zod": "^4.3.6"
  }
}
